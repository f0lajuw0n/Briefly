# Server-only Cohere credential. When present, Briefly uses Chat API V2.
COHERE_API_KEY=

# Optional: defaults to Cohere's current Command A+ model.
COHERE_MODEL=command-a-plus-05-2026

# Supabase authentication (public project URL and anon/publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reserved for future server-side persistence; not used by authentication screens.
SUPABASE_SERVICE_ROLE_KEY=

# Public contact address that receives demo requests via the visitor's email app.
DEMO_REQUEST_EMAIL=
